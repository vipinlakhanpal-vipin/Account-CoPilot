# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "Publishable key" (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase "Secret key" (sb_secret_…). Server-only — never expose to the browser.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# Comma-separated email domains allowed to sign in (e.g. scp-worldwide.com)
ALLOWED_EMAIL_DOMAINS=scp-worldwide.com
